# --- Core ---
ENVIRONMENT=development
LOG_LEVEL=info
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+psycopg://docsdrafter:docsdrafter@localhost:5432/docsdrafter
REDIS_URL=redis://localhost:6379/0
# celery = dispatch jobs to a Celery worker, inline = run them in-process (local dev / tests)
TASK_MODE=celery
AUTO_CREATE_TABLES=false
CORS_ORIGINS=["http://localhost:3000"]

# --- Sessions / CSRF ---
COOKIE_SECURE=false
SESSION_TTL_DAYS=14

# --- AI (provider-neutral, OpenAI-compatible chat/completions) ---
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=4096
AI_TIMEOUT_SECONDS=60

# --- Storage (UploadThing) ---
# local = files written to LOCAL_STORAGE_DIR and served by the API
STORAGE_BACKEND=uploadthing
UPLOADTHING_API_KEY=
UPLOADTHING_APP_ID=
UPLOADTHING_ACL=public-read
LOCAL_STORAGE_DIR=.data/files

# --- PDF rendering: playwright (HTML/CSS) | libreoffice (DOCX -> PDF parity) ---
PDF_RENDERER=playwright
LIBREOFFICE_BIN=soffice
